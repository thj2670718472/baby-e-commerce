# 复制为 .env 后按实际情况填写（.env 不要提交到仓库）
NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dbbabycity
DB_USER=root
DB_PASSWORD=your_db_password
DB_LOGGING=false

# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret
# 待付款订单超时自动取消时间（分钟）
ORDER_TIMEOUT_MINUTES=15
# 已发货订单超过多少天未确认收货时自动完成
AUTO_CONFIRM_DAYS=7
ADMIN_USERNAME=admin
# 可选：仅在首次创建管理员时使用；留空则生成随机密码并只打印一次
ADMIN_INITIAL_PASSWORD=

# 前台地址白名单，逗号分隔
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:8080

# DeepSeek 官方：https://platform.deepseek.com/api_keys
AI_API_KEY=your_deepseek_api_key
AI_API_URL=https://api.deepseek.com/chat/completions
AI_MODEL=deepseek-chat

# ==================== 限流与代理（可选，不填用默认值） ====================
# 部署在 Nginx / 负载均衡后面时填写代理层数（如 1 或 loopback）。
# 不填则按直连处理；填错会让 req.ip 变成代理地址，限流与登录锁定会失效或误伤。
TRUST_PROXY=
# 全局兜底限流：单 IP 每分钟请求数
RATE_LIMIT_MAX=300
# 登录接口单 IP 每 10 分钟尝试次数
LOGIN_RATE_MAX=20

# ==================== 业务限制（可选，不填用默认值） ====================
# 单笔订单最多商品行数
MAX_ORDER_ITEMS=20
# 单用户每分钟下单次数
ORDER_CREATE_MAX=20
# 单用户每天上传图片张数
UPLOAD_DAILY_LIMIT=30
# 聊天图片保留天数（到期自动清理；商品图与头像不受影响）
UPLOAD_RETENTION_DAYS=90

# ==================== WebSocket 约束（可选，不填用默认值） ====================
# 单帧字节上限，超出后连接会被关闭
WS_MAX_PAYLOAD=65536
# 单连接 10 秒内最多消息条数
WS_MESSAGE_MAX=20
# 单条消息最大字符数
WS_MAX_CONTENT=2000
